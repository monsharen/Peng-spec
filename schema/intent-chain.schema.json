{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/monsharen/Peng-spec/schema/intent-chain.schema.json",
  "title": "Intent Integrity Chain Specification",
  "description": "Schema for validating Peng intent integrity chain specs",
  "type": "object",
  "required": ["version", "spec_name", "repository", "chain", "integrity", "build"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "spec_name": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "description": "GitHub owner/repo of the implementation repository"
    },
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/intent"
      }
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "chain_hash"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha512"]
        },
        "chain_hash": {
          "type": "string"
        },
        "last_verified": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "last_build_trigger": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "build": {
      "type": "object",
      "required": ["target_repo", "trigger_on"],
      "properties": {
        "target_repo": {
          "type": "string"
        },
        "trigger_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build_command": {
          "type": "string"
        },
        "test_command": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "required": ["id", "level", "title", "description", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^intent-"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0=root, 1=feature, 2=behavior, 3=contract, 4=verification"
        },
        "parent": {
          "type": "string",
          "description": "ID of parent intent. Omitted for root."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "proposed", "accepted", "implemented", "verified", "deprecated"]
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of child intents"
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of contract intents linked to this behavior"
        },
        "interface": {
          "type": "string",
          "description": "Interface definition for contract-level intents"
        },
        "verification": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["test", "lint", "typecheck", "manual"]
            },
            "command": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
