{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/monsharen/Peng-spec/schema/intent-chain.schema.json",
  "title": "Intent Integrity Chain Manifest",
  "description": "Schema for validating the Peng spec manifest (Gherkin edition)",
  "type": "object",
  "required": ["version", "spec_name", "repository", "intents", "integrity", "build"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "spec_name": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "description": "GitHub owner/repo of the implementation repository"
    },
    "intents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/intent"
      }
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "chain_hash"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha512"]
        },
        "chain_hash": {
          "type": "string"
        },
        "last_verified": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "build": {
      "type": "object",
      "required": ["target_repo", "trigger_on"],
      "properties": {
        "target_repo": {
          "type": "string"
        },
        "trigger_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "build_command": { "type": "string" },
        "test_command": { "type": "string" }
      }
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "file": {
          "type": "string",
          "description": "Path to a .feature file (Gherkin) relative to repo root"
        },
        "parent": {
          "type": "string",
          "description": "ID of parent intent. Omitted for root."
        },
        "children": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of child intents"
        }
      }
    }
  }
}
